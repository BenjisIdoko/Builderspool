// Builders Pool — data model
// Core loop: buyers check out at a fixed catalog price -> paid OrderItems join
// a daily, per-material (per-region if REGIONAL) BidCycle -> sellers submit
// blind Bids against that pooled demand -> winning bids are split into
// Allocations that map back to the individual OrderItems they fill.
//
// Bidding is invisible to the buyer at all times — this schema exists to
// let the backend absorb margin variance, not to expose pooling/bidding UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL points at Supabase's transaction pooler (pgbouncer=true),
  // required for serverless runtime but incompatible with `prisma migrate`'s
  // DDL/advisory-lock needs — migrate hangs indefinitely against it.
  // DIRECT_URL points at the session pooler instead, used only by the CLI
  // for migrations, never at runtime.
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SourcingScope {
  REGIONAL // only sourceable from certain locations
  NATIONAL // sourceable anywhere, pools into one national cycle
}

enum CycleStatus {
  OPEN     // buyers' paid order items and sellers' bids can still join
  CLOSED   // cutoff passed, demand frozen, being scored
  AWARDED  // bids scored and allocated
}

enum BidStatus {
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  REJECTED
  WITHDRAWN
}

enum AllocationStatus {
  PENDING     // awarded, buyer not yet notified/confirmed
  CONFIRMED   // buyer confirmed, ready for fulfillment
  FULFILLED
  CANCELLED   // failed allocation, cascaded to a fallback bid (see lib/bidding/fallback.ts)
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING_GRN // awarded, but the fulfillment center hasn't confirmed physical receipt yet
  PROCESSED   // GRN issued — cleared for disbursement, not yet sent
  PAID        // disbursed to the seller
  ON_HOLD     // an ops exception (quality/count dispute) blocks disbursement
}

// Captured at checkout (2026-09-16) — a real, stored buyer choice, not a
// fabricated one. Doesn't route to a real payment processor yet: same
// honest stub as the rest of checkout (see app/api/checkout/route.ts's
// initiatePayment() TODO). The "escrow" framing this powers is otherwise
// real: Order.status===PAID is the real "funds held" moment, and
// Allocation.payoutStatus's existing PENDING_GRN->PROCESSED->PAID
// lifecycle is the real "release to seller" moment — see
// lib/queries/escrow.ts's getEscrowStatus(), which derives an escrow
// state from those two already-real fields rather than duplicating them.
enum PaymentMethod {
  BANK_TRANSFER
  CARD
  USSD
}

enum DispatchStatus {
  ASSIGNED
  AT_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Real haulage tracking (2026-09-16) — a genuinely new logistics
// subsystem, not a reframe of something that already existed (unlike
// escrow above). One Dispatch per OrderItem that actually needs
// transport (deliveryCost > 0 — a pickup OrderItem never gets one).
// currentLocation is free text ops enters manually; there is no live
// GPS/telemetry integration, so this never fabricates a percentage or
// map position the vehicle hasn't actually reported.
model Vehicle {
  id           String   @id @default(cuid())
  plateNumber  String   @unique
  type         String // e.g. "10-ton flatbed truck", "Dropside truck", "Cargo tricycle"
  capacityTons Float?
  createdAt    DateTime @default(now())

  driver     Driver?
  dispatches Dispatch[]
}

model Driver {
  id            String   @id @default(cuid())
  name          String
  phone         String
  licenseNumber String?
  vehicleId     String?  @unique
  createdAt     DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Dispatch {
  id              String         @id @default(cuid())
  orderItemId     String         @unique
  vehicleId       String?
  status          DispatchStatus @default(ASSIGNED)
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  currentLocation String?
  createdAt       DateTime       @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String   @unique
  phone        String?
  businessName String?
  location     String?
  // Real bcrypt hash (2026-09-16) — nullable only because the seeded demo
  // accounts predate real auth; lib/auth/password.ts + prisma/seed.ts
  // backfill a real hash for every seeded row, and every account created
  // through sign-up gets one at creation. Sign-in refuses a null hash
  // rather than treating it as "no password required."
  passwordHash String?
  createdAt    DateTime @default(now())

  sellerProfile SellerProfile?
  cartItems     CartItem[]
  orders        Order[]
  bids          Bid[]
  priceAlerts   PriceAlert[]
  notifications Notification[]
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

// Seller-specific data. regionsServed feeds the geography eligibility filter;
// trustScore feeds the reliability weight in the award scoring engine.
model SellerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  regionsServed String[]
  trustScore    Float    @default(50)
  createdAt     DateTime @default(now())

  // KYC (2026-09-16) — text/reference fields only, deliberately: this app
  // has no file-storage infra yet, so documentUrl is a link to something
  // already hosted elsewhere rather than a real upload. Real file upload
  // is a flagged follow-up (see BUILDERSPOOL_PROJECT_BRIEF.md), not a
  // fabricated "upload" control that doesn't actually store anything.
  kycStatus          KycStatus @default(NOT_SUBMITTED)
  businessRegNumber  String?
  cacNumber          String?
  idType             String? // e.g. "NIN", "International passport", "Driver's licence"
  idNumber           String?
  documentUrl        String?
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?

  user User @relation(fields: [userId], references: [id])
}

model FulfillmentCenter {
  id        String   @id @default(cuid())
  name      String
  region    String
  address   String
  createdAt DateTime @default(now())

  orderItems OrderItem[]
}

model Material {
  id            String        @id @default(cuid())
  name          String
  category      String
  unit          String // e.g. "50kg bag", "12mm x 12m length", "trip (5 tons)"
  spec          String? // grade, size, brand-neutral spec description (free text)
  // Structured spec fields (2026-09-15) — same real information as `spec`
  // above, broken into a fixed grid for display. Nullable and left blank
  // rather than guessed where the source spec text doesn't clearly state
  // it (e.g. no fabricated compliance/standard codes) — see prisma/seed.ts.
  grade         String?
  standard      String?
  dimensions    String?
  weight        String?
  imageUrl      String? // kept as the single-image fallback everywhere except the PDP gallery
  // Room for a real multi-photo gallery (2026-09-16) — most materials only
  // have zero or one real photo today, so this holds at most `imageUrl`
  // duplicated as a single entry until real additional angles exist. Never
  // backfilled with anything not already a real, stored image.
  images        String[]      @default([])
  catalogPrice  Decimal       @db.Decimal(12, 2) // buyer-facing fixed price
  // Set true only by the catalogue-reference bulk import (2026-09-16) for
  // rows whose real research had no price data ("market rate — set via
  // seller bidding") — catalogPrice is a real Decimal, so those rows get an
  // unmistakable ₦1 placeholder plus this flag, rather than a plausible-
  // looking fabricated number, until admin sets a real price via the
  // materials editor. Never set true any other way.
  needsPriceReview Boolean    @default(false)
  sourcingScope SourcingScope @default(NATIONAL)
  createdAt     DateTime      @default(now())

  cartItems      CartItem[]
  orderItems     OrderItem[]
  bids           Bid[]
  bidCycles      BidCycle[]
  priceSnapshots PriceSnapshot[]
  priceAlerts    PriceAlert[]
}

// A record of what catalogPrice was at a point in time — buyer-safe price
// history, deliberately separate from anything bidding-related. Every
// material starts with exactly one snapshot (backfilled at its createdAt);
// a new row is appended whenever catalogPrice actually changes — either via
// the admin materials editor (app/admin/(dashboard)/materials) or a future
// re-seed.
model PriceSnapshot {
  id         String   @id @default(cuid())
  materialId String
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId, recordedAt])
}

// A buyer's pre-checkout cart line. Simple browsing cart — becomes an
// Order/OrderItem at checkout; never joins a bid cycle directly.
model CartItem {
  id         String   @id @default(cuid())
  buyerId    String
  materialId String
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  buyer    User     @relation(fields: [buyerId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([buyerId, materialId])
}

// The buyer-facing checkout transaction. region is persisted here specifically
// so bid-cycle assignment can read it back after payment confirms.
model Order {
  id            String         @id @default(cuid())
  buyerId       String
  region        String
  status        OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]
}

// One line of a checkout order. priceLocked guarantees the fixed-price promise
// holds regardless of the eventual winning bid. Each item independently joins
// a bid cycle and routes to a fulfillment center once payment is confirmed.
model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  materialId         String
  quantity           Int
  priceLocked        Decimal  @db.Decimal(12, 2)
  deliveryCost       Decimal  @default(0) @db.Decimal(12, 2)
  fulfilmentCenterId String?
  bidCycleId         String?
  createdAt          DateTime @default(now())

  order             Order              @relation(fields: [orderId], references: [id])
  material          Material           @relation(fields: [materialId], references: [id])
  fulfillmentCenter FulfillmentCenter? @relation(fields: [fulfilmentCenterId], references: [id])
  bidCycle          BidCycle?          @relation(fields: [bidCycleId], references: [id])
  allocations       Allocation[]
  dispatch          Dispatch?
}

// One per material, per region (null = national), per day.
//
// Note: Postgres treats NULL as distinct across rows in a unique index, so
// @@unique([materialId, region, date]) does not by itself prevent duplicate
// national (region: null) cycles for the same material/day — joinCycle.ts
// guards this at the application level with a findFirst-then-create inside
// a transaction instead of relying on the DB constraint alone.
model BidCycle {
  id         String      @id @default(cuid())
  materialId String
  region     String?
  date       DateTime    @db.Date
  cutoffAt   DateTime
  status     CycleStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  material   Material    @relation(fields: [materialId], references: [id])
  orderItems OrderItem[]
  bids       Bid[]

  @@unique([materialId, region, date])
}

// A seller's blind offer to supply a quantity of one material within one cycle.
model Bid {
  id                    String    @id @default(cuid())
  sellerId              String
  materialId            String
  cycleId               String
  unitPrice             Decimal   @db.Decimal(12, 2)
  quantityOffered       Int
  estimatedDeliveryDays Int
  score                 Float? // filled in at award time
  rank                  Int? // filled in at award time
  status                BidStatus @default(SUBMITTED)
  submittedAt           DateTime  @default(now())

  seller   User     @relation(fields: [sellerId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  cycle    BidCycle @relation(fields: [cycleId], references: [id])

  allocations Allocation[]

  @@index([materialId, cycleId, unitPrice])
}

enum NotificationType {
  CYCLE_OPENED
  CYCLE_CLOSING_SOON
  BID_WON
  BID_LOST
}

// Real, event-driven in-app alerts — created only from an actual bidding
// event (a cycle a seller is eligible for opening/closing soon, or their
// own bid's real award outcome), never a synthetic/sample notification.
// No email/SMS delivery exists in this app (see BUILDERSPOOL_PROJECT_BRIEF.md),
// so this is in-app only for now.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String? // where "View" should take the recipient
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

// The resolved link: how much of a winning Bid fills a specific OrderItem.
// Supports split awards (multiple allocations per bid cycle) and the fallback
// cascade (a cancelled allocation's quantity becomes a new allocation against
// the next-ranked bid). receivedAt is the GRN (Goods Received Note) capture —
// a fulfillment center confirming a seller's drop-off — and is the trigger
// point for seller payout.
model Allocation {
  id             String           @id @default(cuid())
  bidId          String
  orderItemId    String
  quantityFilled Int
  status         AllocationStatus @default(PENDING)
  receivedAt     DateTime?
  grnNumber      String?          @unique // set together with receivedAt when the GRN is issued
  createdAt      DateTime         @default(now())

  payoutStatus    PayoutStatus @default(PENDING_GRN)
  payoutReference String?      @unique // set when payoutStatus becomes PAID
  paidAt          DateTime?
  holdReason      String? // set when payoutStatus is ON_HOLD, cleared on release

  bid       Bid       @relation(fields: [bidId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

// A buyer's stored "notify me at this price" request. Stored only — there's
// no email/SMS delivery infrastructure yet, so nothing actually sends a
// notification. `active` lets a buyer cancel one; whether the target has
// already been reached is computed at read time from the real catalogPrice,
// never fabricated.
model PriceAlert {
  id          String    @id @default(cuid())
  materialId  String
  buyerId     String
  targetPrice Decimal   @db.Decimal(12, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  material Material @relation(fields: [materialId], references: [id])
  buyer    User     @relation(fields: [buyerId], references: [id])

  @@index([materialId, active])
}

// ─────────────────────────────────────────────────────────────
// Catalogue reference library (2026-09-16) — a researched spec/standard/
// brand reference for the wider Nigerian construction-materials market
// (17 categories, ~134 products), sourced from an external data file, NOT
// the live buyer catalog. Deliberately standalone — no relation to Material
// or anything buyer-facing. Most of these products have no fixed price
// (their source notes say "market rate — set via seller bidding; verify
// live"), so they can't honestly become real, orderable Material rows
// without a price; this exists so ops/admin has real spec data to work
// from when they do add one by hand. No UI reads this yet — it's schema +
// seed data only until an admin-facing browse view is built.
//
// SourcingModel is intentionally its own enum, not Material's
// SourcingScope — this is reference metadata (BOTH is a real value here)
// describing how a product type is typically sourced across the market,
// not the operational field that drives actual bid-cycle pooling.
enum ProjectScale {
  SMALL
  MEGA
  BOTH
}

enum SourcingModel {
  NATIONAL
  REGIONAL
  BOTH
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String        @id @default(cuid())
  sku             String        @unique
  name            String
  slug            String        @unique
  description     String?
  specification   String? // e.g. "Nominal dia. 12mm; Grade 460"
  standard        String? // e.g. "BS 4449", "NIS 87:2004"
  commonBrands    String? // free-text list of brands that satisfy this spec — split on comma in the UI if needed
  brand           String? // set only for a brand-specific SKU; null = generic/any conforming brand
  unitOfSale      String // "Bag", "Length", "m²", "Trip", "Piece", etc.
  packSize        String? // typical bundle/pallet/load size
  projectScale    ProjectScale  @default(BOTH)
  sourcingModel   SourcingModel @default(BOTH)
  priceNote       String? // reference only — never a real catalogPrice; most say "set via seller bidding"
  imageSearchTerm String? // starting query for sourcing a product photo
  imageUrl        String? // populate once real photography/licensed images are sourced
  notes           String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brand])
}
