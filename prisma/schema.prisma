// Builders Pool — data model
// Core loop: buyers check out at a fixed catalog price -> paid OrderItems join
// a daily, per-material (per-region if REGIONAL) BidCycle -> sellers submit
// blind Bids against that pooled demand -> winning bids are split into
// Allocations that map back to the individual OrderItems they fill.
//
// Bidding is invisible to the buyer at all times — this schema exists to
// let the backend absorb margin variance, not to expose pooling/bidding UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL points at Supabase's transaction pooler (pgbouncer=true),
  // required for serverless runtime but incompatible with `prisma migrate`'s
  // DDL/advisory-lock needs — migrate hangs indefinitely against it.
  // DIRECT_URL points at the session pooler instead, used only by the CLI
  // for migrations, never at runtime.
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
  // Added 2026-11-04 (Transfer File section 5.1). SELLER_STAFF acts for one
  // seller owner (see SellerStaff) and cannot change bank details, terms or
  // KYC. The other three are internal BuildersPool operations roles; their
  // consoles ship with the catalogue (QC) and fulfilment phases.
  SELLER_STAFF
  QC_OFFICER
  FULFILMENT_OPERATOR
  DELIVERY_PARTNER
}

enum SourcingScope {
  REGIONAL // only sourceable from certain locations
  NATIONAL // sourceable anywhere, pools into one national cycle
}

enum CycleStatus {
  OPEN // collecting demand: paid order items join until poolClosesAt
  BIDDING // pool frozen, RFQ issued: approved sellers bid blind until bidsCloseAt
  CLOSED // bidding closed, being scored
  AWARDED // bids scored and allocated (acceptance, cascade and fallback follow)
}

enum BidStatus {
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  REJECTED
  WITHDRAWN
}

enum AllocationStatus {
  PENDING // awarded, buyer not yet notified/confirmed
  CONFIRMED // buyer confirmed, ready for fulfillment
  FULFILLED
  CANCELLED // failed allocation, cascaded to a fallback bid (see lib/bidding/fallback.ts)
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

// How an order line is bought. POOL joins the daily pool and its bidding; DIRECT
// goes straight to the seller whose listing the buyer picked.
enum PurchaseMode {
  POOL
  DIRECT
}

// A Buy Direct line's life with the seller: they accept (or decline, or let the
// window lapse), ship to the fulfilment centre, and are paid after the goods are
// received and checked. Mirrors AllocationStatus for pooled lines.
enum DirectStatus {
  AWAITING_ACCEPT
  ACCEPTED
  FULFILLED
  DECLINED
  EXPIRED
}

enum PayoutStatus {
  PENDING_GRN // awarded, but the fulfillment center hasn't confirmed physical receipt yet
  PROCESSED // GRN issued — cleared for disbursement, not yet sent
  PAID // disbursed to the seller
  ON_HOLD // an ops exception (quality/count dispute) blocks disbursement
}

// Captured at checkout (2026-09-16) — a real, stored buyer choice, not a
// fabricated one. Doesn't route to a real payment processor yet: same
// honest stub as the rest of checkout (see app/api/checkout/route.ts's
// initiatePayment() TODO). The "escrow" framing this powers is otherwise
// real: Order.status===PAID is the real "funds held" moment, and
// Allocation.payoutStatus's existing PENDING_GRN->PROCESSED->PAID
// lifecycle is the real "release to seller" moment — see
// lib/queries/escrow.ts's getEscrowStatus(), which derives an escrow
// state from those two already-real fields rather than duplicating them.
enum PaymentMethod {
  BANK_TRANSFER
  CARD
  USSD
}

enum DispatchStatus {
  ASSIGNED
  AT_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Real haulage tracking (2026-09-16) — a genuinely new logistics
// subsystem, not a reframe of something that already existed (unlike
// escrow above). One Dispatch per OrderItem that actually needs
// transport (deliveryCost > 0 — a pickup OrderItem never gets one).
// currentLocation is free text ops enters manually; there is no live
// GPS/telemetry integration, so this never fabricates a percentage or
// map position the vehicle hasn't actually reported.
model Vehicle {
  id           String   @id @default(cuid())
  plateNumber  String   @unique
  type         String // e.g. "10-ton flatbed truck", "Dropside truck", "Cargo tricycle"
  capacityTons Float?
  createdAt    DateTime @default(now())

  driver     Driver?
  dispatches Dispatch[]
}

model Driver {
  id            String   @id @default(cuid())
  name          String
  phone         String
  licenseNumber String?
  vehicleId     String?  @unique
  createdAt     DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Dispatch {
  id              String         @id @default(cuid())
  orderItemId     String         @unique
  vehicleId       String?
  status          DispatchStatus @default(ASSIGNED)
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  currentLocation String?
  createdAt       DateTime       @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])
}

model User {
  id              String    @id @default(cuid())
  role            Role
  name            String
  email           String    @unique
  phone           String?
  businessName    String?
  location        String?
  // Real bcrypt hash (2026-09-16) — nullable only because the seeded demo
  // accounts predate real auth; lib/auth/password.ts + prisma/seed.ts
  // backfill a real hash for every seeded row, and every account created
  // through sign-up gets one at creation. Sign-in refuses a null hash
  // rather than treating it as "no password required."
  passwordHash    String?
  createdAt       DateTime  @default(now())
  // Null until the user clicks a real verification-email link (lib/auth/
  // emailVerification.ts). Deliberately not enforced anywhere yet — no
  // action in the app is gated on this — it's tracked and surfaced as a
  // dismissible banner, not a hard requirement, so verification doesn't
  // change any existing user's ability to use the app.
  emailVerifiedAt DateTime?
  // Set by an admin (internal staff) or the seller owner (their staff) to stop
  // an account signing in; sessions are revoked at the same moment.
  disabledAt      DateTime?

  staffMembership         SellerStaff?             @relation("StaffUser")
  staff                   SellerStaff[]            @relation("SellerOwner")
  sellerProfile           SellerProfile?
  sessions                Session[]
  cartItems               CartItem[]
  orders                  Order[]
  bids                    Bid[]
  priceAlerts             PriceAlert[]
  notifications           Notification[]
  savingsWalletEntries    SavingsWalletEntry[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  zoneCoverage            SellerZoneCoverage[]
  listings                SellerListing[]
  directFulfilments       DirectFulfilment[]
}

// One row per requested reset — tokenHash is the only thing ever stored
// (sha256 of the raw token emailed to the user), so a database read alone
// can never yield a usable token. usedAt is set (not deleted) so a reused
// link fails loudly rather than silently 404ing.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Same shape and hashing convention as PasswordResetToken, kept as a
// separate model rather than a shared "purpose" enum — the two have
// different expiries and are issued/consumed independently, and keeping
// them apart avoids one code path accidentally accepting the other's token.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Real, honest brute-force protection — every sign-in attempt across all
// three roles (buyer/seller/admin) writes one row here before the identity
// check even resolves whether the email exists, so failed attempts against
// a nonexistent account are throttled identically to a real one (no
// enumeration signal via timing/lockout behavior).
// Server-side login sessions (2026-10-03). The cookie holds a random 256-bit
// token; only its SHA-256 hash is stored here (same principle as the
// password-reset tokens), so a DB read can't forge a session and a leaked
// user id is worthless. Rows are deleted on sign-out and on password reset,
// which is what makes a session revocable.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  role      Role
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Every acceptance of the seller terms, by version — never overwritten, so we
// can show who accepted which version when.
model SellerTermsAcceptance {
  id           String   @id @default(cuid())
  sellerUserId String
  version      String
  acceptedById String
  acceptedAt   DateTime @default(now())

  @@index([sellerUserId, version])
}

// Links a SELLER_STAFF user to the seller owner they work for. Staff act on the
// owner's seller account (bids, orders, allocations) through the same portal.
model SellerStaff {
  id           String   @id @default(cuid())
  userId       String   @unique
  sellerUserId String
  createdById  String?
  createdAt    DateTime @default(now())

  user   User @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  seller User @relation("SellerOwner", fields: [sellerUserId], references: [id], onDelete: Cascade)

  @@index([sellerUserId])
}

enum LedgerAccount {
  BUYER_SAVINGS_CREDIT // the buyer's share of a verified Pool & Save saving
  PLATFORM_SAVINGS_SHARE // BuildersPool's share of that saving
  SELLER_PAYABLE // owed to a seller once goods are received (payouts disabled in the MVP)
  BUYER_REFUND_DUE // paid by the buyer for units no supplier covered
  PLATFORM_COMMISSION // Buy Direct commission
  PLATFORM_DELIVERY // platform delivery fee
}

// Append-only money ledger in integer kobo (Transfer File section 4). A row is
// never updated or deleted — a correction is a new compensating row — which a
// database trigger enforces. entryKey makes every write idempotent.
model LedgerEntry {
  id           String        @id @default(cuid())
  account      LedgerAccount
  amountKobo   BigInt
  entryKey     String        @unique
  memo         String
  orderId      String?
  orderItemId  String?
  allocationId String?
  userId       String? // the buyer or seller the entry is owed to / from
  createdAt    DateTime      @default(now())

  @@index([account, createdAt])
  @@index([allocationId])
  @@index([userId])
}

// Platform settings editable by admins (Admin > Settings). One row per key; a
// key with no row falls back to the default in lib/settings/definitions.ts, so
// a fresh database needs no seeding. Values are JSON (numbers, strings,
// booleans). Every change is also written to AuditLog.
model AdminSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Append-only record of who did what — admin and ops actions that change
// money, access or configuration. Rows are never updated or deleted by the
// app; a correction is a new row.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String // dotted verb, e.g. "kyc.approved", "settings.updated"
  entityType String // e.g. "SellerProfile", "Allocation", "AdminSetting"
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // lowercased email
  succeeded  Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  // An approved seller an admin has paused (Transfer File 5.3): they keep their
  // login but cannot bid or be awarded until reactivated.
  SUSPENDED
}

// Seller-specific data. regionsServed feeds the geography eligibility filter;
// trustScore feeds the reliability weight in the award scoring engine.
model SellerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  regionsServed  String[]
  trustScore     Float    @default(50)
  createdAt      DateTime @default(now())
  // Founder's "national supply": covers every delivery zone (the call's
  // "except national products"). Coverage per zone otherwise: SellerZoneCoverage.
  nationalSupply Boolean  @default(false)

  // KYC (2026-09-16) — text/reference fields only, deliberately: this app
  // has no file-storage infra yet, so documentUrl is a link to something
  // already hosted elsewhere rather than a real upload. Real file upload
  // is a flagged follow-up (see BUILDERSPOOL_PROJECT_BRIEF.md), not a
  // fabricated "upload" control that doesn't actually store anything.
  kycStatus          KycStatus @default(NOT_SUBMITTED)
  businessRegNumber  String?
  cacNumber          String?
  idType             String? // e.g. "NIN", "International passport", "Driver's licence"
  idNumber           String?
  documentUrl        String? // legacy pasted link, from before real upload
  documentPath       String? // object path in the private kyc-documents bucket
  documentName       String? // original filename, display only
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?

  // CAC verification (2026-09-30) — an automated cross-check of cacNumber
  // against the real Corporate Affairs Commission registry via MetaMap's
  // GovChecks API (lib/kyc/metamap.ts), independent of the manual admin
  // review above. Tied to the exact cacNumber it verified: submitKyc clears
  // these when cacNumber changes so a stale result never describes a
  // different company (same reasoning as Material.retired vs
  // needsPriceReview never overlapping).
  // KYC to spec (2026-11-04, Transfer File 5.3). bankNameMatch compares the
  // account name with the verified company name (lib/kyc/nameMatch.ts) so a
  // reviewer sees a mismatch before approving; documentExpiresAt is the
  // supporting document's own expiry (e.g. a SON certificate).
  tin               String?
  businessAddress   String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankNameMatch     String? // MATCH | PARTIAL | MISMATCH
  documentExpiresAt DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  cacVerifiedAt          DateTime?
  cacVerifiedCompanyName String?
  cacVerifiedStatus      String? // CAC registry's own ACTIVE/INACTIVE, not kycStatus
  cacVerifiedEntityType  String? // BN, RC, or LLC
  cacVerificationError   String?

  user User @relation(fields: [userId], references: [id])
}

model FulfillmentCenter {
  id         String   @id @default(cuid())
  name       String
  region     String
  address    String
  createdAt  DateTime @default(now())
  // The centre's own locality (service areas, docs/floot-port-notes.md 2.11).
  localityId String?

  locality   Locality?   @relation(fields: [localityId], references: [id])
  orderItems OrderItem[]
}

model Material {
  id               String        @id @default(cuid())
  name             String
  category         String
  unit             String // e.g. "50kg bag", "12mm x 12m length", "trip (5 tons)"
  spec             String? // grade, size, brand-neutral spec description (free text)
  // Structured spec fields (2026-09-15) — same real information as `spec`
  // above, broken into a fixed grid for display. Nullable and left blank
  // rather than guessed where the source spec text doesn't clearly state
  // it (e.g. no fabricated compliance/standard codes) — see prisma/seed.ts.
  grade            String?
  standard         String?
  dimensions       String?
  weight           String?
  imageUrl         String? // kept as the single-image fallback everywhere except the PDP gallery
  // Room for a real multi-photo gallery (2026-09-16) — most materials only
  // have zero or one real photo today, so this holds at most `imageUrl`
  // duplicated as a single entry until real additional angles exist. Never
  // backfilled with anything not already a real, stored image.
  images           String[]      @default([])
  catalogPrice     Decimal       @db.Decimal(12, 2) // buyer-facing fixed price
  // Set true only by the catalogue-reference bulk import (2026-09-16) for
  // rows whose real research had no price data ("market rate — set via
  // seller bidding") — catalogPrice is a real Decimal, so those rows get an
  // unmistakable ₦1 placeholder plus this flag, rather than a plausible-
  // looking fabricated number, until admin sets a real price via the
  // materials editor. Never set true any other way.
  needsPriceReview Boolean       @default(false)
  // A row admin has deliberately taken off the live catalog — e.g. a
  // duplicate of another row kept for its order/bid history, which can't be
  // deleted outright. Distinct from needsPriceReview: a retired row is not
  // "awaiting a price," so it must never sit in that review queue. Buyer
  // queries exclude retired rows the same way they exclude needsPriceReview
  // ones (see BUYER_VISIBLE, lib/queries/materials.ts); admin still sees
  // them, badged, since this app keeps a real record rather than hiding
  // state outright.
  retired          Boolean       @default(false)
  // Perishables need at least 30 days of shelf life on a seller's listing
  // (upload checks, docs/floot-port-notes.md 1c). Off for everything today.
  perishable       Boolean       @default(false)
  sourcingScope    SourcingScope @default(NATIONAL)
  createdAt        DateTime      @default(now())

  cartItems      CartItem[]
  orderItems     OrderItem[]
  bids           Bid[]
  bidCycles      BidCycle[]
  priceSnapshots PriceSnapshot[]
  priceAlerts    PriceAlert[]
  listings       SellerListing[]
}

// A record of what catalogPrice was at a point in time — buyer-safe price
// history, deliberately separate from anything bidding-related. Every
// material starts with exactly one snapshot (backfilled at its createdAt);
// a new row is appended whenever catalogPrice actually changes — either via
// the admin materials editor (app/admin/(dashboard)/materials) or a future
// re-seed.
model PriceSnapshot {
  id         String   @id @default(cuid())
  materialId String
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId, recordedAt])
}

// A buyer's pre-checkout cart line. Simple browsing cart — becomes an
// Order/OrderItem at checkout; never joins a bid cycle directly.
model CartItem {
  id         String   @id @default(cuid())
  buyerId    String
  materialId String
  quantity   Int
  // The seller offer the buyer picked for this line; null = no pick (the
  // catalogue price applies, as before).
  listingId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  buyer    User           @relation(fields: [buyerId], references: [id])
  material Material       @relation(fields: [materialId], references: [id])
  listing  SellerListing? @relation(fields: [listingId], references: [id])

  @@unique([buyerId, materialId])
}

// The buyer-facing checkout transaction. region is persisted here specifically
// so bid-cycle assignment can read it back after payment confirms.
model Order {
  id               String         @id @default(cuid())
  buyerId          String
  region           String
  status           OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod?
  paymentReference String?        @unique // Paystack transaction reference for the current/latest payment attempt
  createdAt        DateTime       @default(now())
  paidAt           DateTime?

  // Delivery destination — set only for DELIVERY orders (checkout leaves these
  // null for PICKUP; a buyer collecting in person has no site to route a
  // driver to). Required at the application layer, not the schema, so
  // pre-migration orders and pickup orders stay valid rows. This is where the
  // order goes after Builders Pool's own fulfillment center — the seller
  // never sees it, matching the existing "seller ships to the center, ops
  // handles the last hop" model.
  deliveryAddress      String?
  deliveryContactName  String?
  deliveryContactPhone String?
  deliveryWindow       String? // free text (e.g. "Weekday mornings") — no delivery-slot system exists to validate against
  deliveryNotes        String? // offload/access notes for the driver

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]
}

// One line of a checkout order. priceLocked guarantees the fixed-price promise
// holds regardless of the eventual winning bid. Each item independently joins
// a bid cycle and routes to a fulfillment center once payment is confirmed.
model OrderItem {
  id                 String       @id @default(cuid())
  orderId            String
  materialId         String
  quantity           Int
  priceLocked        Decimal      @db.Decimal(12, 2)
  deliveryCost       Decimal      @default(0) @db.Decimal(12, 2)
  fulfilmentCenterId String?
  bidCycleId         String?
  // Units no winning supplier covered once the fallback time passed. Never
  // converted into a purchase the buyer didn't authorise; the unfilled value
  // is recorded as a refund due on the ledger.
  unfilledQuantity   Int          @default(0)
  // The seller offer the buyer picked, and so the seller a cancelled pool
  // reverts to; priceLocked is that offer's price. Null on older orders and
  // on lines bought before any seller had a live listing.
  listingId          String?
  mode               PurchaseMode @default(POOL)
  createdAt          DateTime     @default(now())

  order             Order              @relation(fields: [orderId], references: [id])
  listing           SellerListing?     @relation(fields: [listingId], references: [id])
  material          Material           @relation(fields: [materialId], references: [id])
  fulfillmentCenter FulfillmentCenter? @relation(fields: [fulfilmentCenterId], references: [id])
  bidCycle          BidCycle?          @relation(fields: [bidCycleId], references: [id])
  allocations       Allocation[]
  dispatch          Dispatch?
  direct            DirectFulfilment?
}

// One per material, per region (null = national), per day.
//
// Note: Postgres treats NULL as distinct across rows in a unique index, so
// @@unique([materialId, region, date]) does not by itself prevent duplicate
// national (region: null) cycles for the same material/day — joinCycle.ts
// guards this at the application level with a findFirst-then-create inside
// a transaction instead of relying on the DB constraint alone.
model BidCycle {
  id         String      @id @default(cuid())
  materialId String
  region     String?
  date       DateTime    @db.Date
  cutoffAt   DateTime // = bidsCloseAt; kept for older code and screens
  status     CycleStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  // The daily timeline (Transfer File 5.4), set from Admin > Settings in
  // Africa/Lagos time when the cycle is created. Null on cycles created before
  // 2026-11-05.
  poolClosesAt        DateTime?
  bidsCloseAt         DateTime?
  acceptDeadlineAt    DateTime?
  fallbackAt          DateTime?
  frozenAt            DateTime?
  awardedAt           DateTime?
  fallbackProcessedAt DateTime?

  material   Material    @relation(fields: [materialId], references: [id])
  orderItems OrderItem[]
  bids       Bid[]

  @@unique([materialId, region, date])
}

// A seller's blind offer to supply a quantity of one material within one cycle.
model Bid {
  id                    String    @id @default(cuid())
  sellerId              String
  materialId            String
  cycleId               String
  unitPrice             Decimal   @db.Decimal(12, 2)
  quantityOffered       Int
  estimatedDeliveryDays Int
  score                 Float? // filled in at award time
  rank                  Int? // filled in at award time
  status                BidStatus @default(SUBMITTED)
  submittedAt           DateTime  @default(now())
  // Why an otherwise-submitted bid was excluded at award (eligibility reason
  // code, e.g. NOT_APPROVED, OUTSIDE_SERVICE_AREA, OVER_WINNER_CAP).
  rejectionReason       String?

  seller   User     @relation(fields: [sellerId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  cycle    BidCycle @relation(fields: [cycleId], references: [id])

  allocations Allocation[]

  @@index([materialId, cycleId, unitPrice])
}

enum NotificationType {
  CYCLE_OPENED
  CYCLE_CLOSING_SOON
  BID_WON
  BID_LOST
}

// Real, event-driven in-app alerts — created only from an actual bidding
// event (a cycle a seller is eligible for opening/closing soon, or their
// own bid's real award outcome), never a synthetic/sample notification.
// No email/SMS delivery exists in this app (see BUILDERSPOOL_PROJECT_BRIEF.md),
// so this is in-app only for now.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String? // where "View" should take the recipient
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

// The resolved link: how much of a winning Bid fills a specific OrderItem.
// Supports split awards (multiple allocations per bid cycle) and the fallback
// cascade (a cancelled allocation's quantity becomes a new allocation against
// the next-ranked bid). receivedAt is the GRN (Goods Received Note) capture —
// a fulfillment center confirming a seller's drop-off — and is the trigger
// point for seller payout.
model Allocation {
  id               String           @id @default(cuid())
  bidId            String
  orderItemId      String
  quantityFilled   Int
  status           AllocationStatus @default(PENDING)
  // The seller must accept an award by acceptDeadlineAt (Transfer File 5.4); a
  // decline or a timeout passes the quantity to the next-ranked bid
  // (cascadeRound counts the passes; the second round is final).
  acceptedAt       DateTime?
  declinedAt       DateTime?
  acceptDeadlineAt DateTime?
  cascadeRound     Int              @default(0)
  cancelReason     String?
  receivedAt       DateTime?
  grnNumber        String?          @unique // set together with receivedAt when the GRN is issued
  createdAt        DateTime         @default(now())

  payoutStatus    PayoutStatus @default(PENDING_GRN)
  payoutReference String?      @unique // set when payoutStatus becomes PAID
  paidAt          DateTime?
  holdReason      String? // set when payoutStatus is ON_HOLD, cleared on release

  bid       Bid       @relation(fields: [bidId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  savingsWalletEntry SavingsWalletEntry?
}

enum WalletEntryState {
  AVAILABLE
  WITHDRAWAL_REQUESTED
  PAID
}

// Per the developer brief's Savings Wallet (Section 17): the buyer pays a
// fixed reference price; the platform's real procurement cost is whatever
// the winning bid actually cost. The gap is a real, honest number — this
// app already derives it for admin's "platform margin" KPI — split 50/50
// between buyer and platform instead of keeping the full gap as revenue.
// One entry per Allocation (the real event that finalizes both the
// quantity and the unit price actually paid), created only once a GRN
// confirms real fulfillment — never before, and never negative (a bid
// that ends up costing more than the reference price is a margin loss
// the business absorbs, not a debt charged back to the buyer).
model SavingsWalletEntry {
  id                    String           @id @default(cuid())
  buyerId               String
  allocationId          String           @unique
  referenceValue        Decimal          @db.Decimal(12, 2) // what the buyer actually paid for this quantity (locked checkout price)
  actualValue           Decimal          @db.Decimal(12, 2) // what the platform actually paid the winning seller
  grossSaving           Decimal          @db.Decimal(12, 2) // referenceValue - actualValue, always > 0
  buyerShare            Decimal          @db.Decimal(12, 2) // grossSaving / 2 — the real wallet credit
  state                 WalletEntryState @default(AVAILABLE)
  withdrawalRequestedAt DateTime?
  paidAt                DateTime?
  paymentReference      String?          @unique // set when marked PAID — same manual-ops pattern as seller payoutReference, no live payment rail exists yet
  createdAt             DateTime         @default(now())

  buyer      User       @relation(fields: [buyerId], references: [id])
  allocation Allocation @relation(fields: [allocationId], references: [id])

  @@index([buyerId, state])
}

// A buyer's stored "notify me at this price" request. Stored only — there's
// no email/SMS delivery infrastructure yet, so nothing actually sends a
// notification. `active` lets a buyer cancel one; whether the target has
// already been reached is computed at read time from the real catalogPrice,
// never fabricated.
model PriceAlert {
  id          String   @id @default(cuid())
  materialId  String
  buyerId     String
  targetPrice Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  buyer    User     @relation(fields: [buyerId], references: [id])

  @@index([materialId, active])
}

// ─────────────────────────────────────────────────────────────
// Catalogue reference library (2026-09-16) — a researched spec/standard/
// brand reference for the wider Nigerian construction-materials market
// (17 categories, ~134 products), sourced from an external data file, NOT
// the live buyer catalog. Deliberately standalone — no relation to Material
// or anything buyer-facing. Most of these products have no fixed price
// (their source notes say "market rate — set via seller bidding; verify
// live"), so they can't honestly become real, orderable Material rows
// without a price; this exists so ops/admin has real spec data to work
// from when they do add one by hand. No UI reads this yet — it's schema +
// seed data only until an admin-facing browse view is built.
//
// SourcingModel is intentionally its own enum, not Material's
// SourcingScope — this is reference metadata (BOTH is a real value here)
// describing how a product type is typically sourced across the market,
// not the operational field that drives actual bid-cycle pooling.
enum ProjectScale {
  SMALL
  MEGA
  BOTH
}

enum SourcingModel {
  NATIONAL
  REGIONAL
  BOTH
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String        @id @default(cuid())
  sku             String        @unique
  name            String
  slug            String        @unique
  description     String?
  specification   String? // e.g. "Nominal dia. 12mm; Grade 460"
  standard        String? // e.g. "BS 4449", "NIS 87:2004"
  commonBrands    String? // free-text list of brands that satisfy this spec — split on comma in the UI if needed
  brand           String? // set only for a brand-specific SKU; null = generic/any conforming brand
  unitOfSale      String // "Bag", "Length", "m²", "Trip", "Piece", etc.
  packSize        String? // typical bundle/pallet/load size
  projectScale    ProjectScale  @default(BOTH)
  sourcingModel   SourcingModel @default(BOTH)
  priceNote       String? // reference only — never a real catalogPrice; most say "set via seller bidding"
  imageSearchTerm String? // starting query for sourcing a product photo
  imageUrl        String? // populate once real photography/licensed images are sourced
  notes           String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brand])
}

// ─── Service areas (docs/floot-port-notes.md 2.11) ───────────────────────────
// State -> Area Council (LGA) -> locality -> delivery zone. A locality belongs
// to exactly one LGA and at most one active zone. The ZONE is the pool key,
// the delivery-fee holder and the unit of seller coverage; localities only
// decide which zone an address falls in. Additive tables: nothing here is read
// by checkout or the engine until the later phases wire it in.

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  lgas Lga[]
}

model Lga {
  id        String   @id @default(cuid())
  stateId   String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  state      State      @relation(fields: [stateId], references: [id])
  localities Locality[]

  @@unique([stateId, name])
}

enum LocalityKind {
  CITY
  TOWN
  DISTRICT
}

model Locality {
  id        String       @id @default(cuid())
  lgaId     String
  zoneId    String? // null = not in any zone yet: no delivery, pickup only
  name      String
  kind      LocalityKind @default(DISTRICT)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  lga                Lga                 @relation(fields: [lgaId], references: [id])
  zone               DeliveryZone?       @relation(fields: [zoneId], references: [id])
  fulfillmentCenters FulfillmentCenter[]
  deliveryRequests   DeliveryRequest[]

  @@unique([lgaId, name])
  @@index([zoneId])
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String   @unique
  active      Boolean  @default(true)
  // Flat delivery fee in naira, entered by the business in admin. null means
  // no fee has been set, so the zone offers pickup only (never a default).
  deliveryFee Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  localities Locality[]
  coverage   SellerZoneCoverage[]
}

enum CoverageStatus {
  PENDING // the seller asked to cover this zone
  APPROVED // ops approved it
  REVOKED // ops removed it
}

model SellerZoneCoverage {
  id          String         @id @default(cuid())
  sellerId    String // the seller's User id
  zoneId      String
  status      CoverageStatus @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime       @default(now())

  seller User         @relation(fields: [sellerId], references: [id])
  zone   DeliveryZone @relation(fields: [zoneId], references: [id])

  @@unique([sellerId, zoneId])
  @@index([zoneId, status])
}

// "Tell us you want delivery here": a buyer in a locality we cannot deliver to
// leaves a phone number. One row per phone and locality.
model DeliveryRequest {
  id         String   @id @default(cuid())
  phone      String
  localityId String
  createdAt  DateTime @default(now())

  locality Locality @relation(fields: [localityId], references: [id])

  @@unique([phone, localityId])
}

// ─── Seller listings (docs/floot-port-notes.md 1c, upload checks) ────────────
// A seller's own offer for a catalogue material: their price, stock, lead time
// and photos. Buy Direct shows these as an offers list; the pool reference
// price is the lowest ACTIVE listing among sellers serving the buyer's zone.
// Material stays the product definition. Additive: nothing reads listings
// until the later phases wire them in.

enum ListingStatus {
  DRAFT // seller is still editing
  PENDING_REVIEW // flagged by the upload checks, waiting for ops
  ACTIVE // visible to buyers
  PAUSED // the seller switched it off
  REJECTED // failed the checks or ops declined it
}

enum ListingQcResult {
  PASSED
  NEEDS_REVIEW
  REJECTED
}

model SellerListing {
  id            String           @id @default(cuid())
  sellerId      String // the seller's User id
  materialId    String
  price         Decimal          @db.Decimal(12, 2) // the seller's own price, per Material.unit
  stockQty      Int              @default(0)
  leadTimeDays  Int              @default(1)
  shelfLifeDays Int? // required when Material.perishable
  status        ListingStatus    @default(DRAFT)
  qcResult      ListingQcResult?
  // Reason codes from the upload checks, e.g. PRICE_OUT_OF_RANGE,
  // PHOTO_TOO_SMALL, SHELF_LIFE_SHORT, DUPLICATE. Explainable by design.
  qcReasons     String[]         @default([])
  // Median of the other active listings when the price check ran, so a reviewer
  // sees what the 50-150% band was measured against.
  qcMedianPrice Decimal?         @db.Decimal(12, 2)
  qcCheckedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  seller     User           @relation(fields: [sellerId], references: [id])
  material   Material       @relation(fields: [materialId], references: [id])
  photos     ListingPhoto[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([sellerId, materialId])
  @@index([materialId, status])
  @@index([status])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  path      String // object path in the listing-photos bucket
  widthPx   Int
  heightPx  Int
  sizeBytes Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listing SellerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// One per Buy Direct order line, created when the order is paid. The price is
// the picked listing's price locked at checkout; payout reuses PayoutStatus so
// escrow, GRN and payout screens read the same lifecycle as pooled lines.
model DirectFulfilment {
  id               String       @id @default(cuid())
  orderItemId      String       @unique
  sellerId         String // the seller's User id
  listingId        String?
  quantity         Int
  unitPrice        Decimal      @db.Decimal(12, 2)
  status           DirectStatus @default(AWAITING_ACCEPT)
  acceptDeadlineAt DateTime
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declineReason    String?
  receivedAt       DateTime?
  grnNumber        String?      @unique
  payoutStatus     PayoutStatus @default(PENDING_GRN)
  payoutReference  String?      @unique
  paidAt           DateTime?
  holdReason       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  seller    User      @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([status, acceptDeadlineAt])
}
